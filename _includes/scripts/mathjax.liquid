{% if site.enable_math %}
  {% unless page.pseudocode %}
    <!-- MathJax -->
    <script type="text/javascript">
      window.MathJax = {
        tex: {
          tags: 'ams',
        },
        chtml: {
          // MathJax's math font renders capital letters visually larger than
          // the surrounding body text at the same nominal font-size, so scale
          // the whole output down slightly to match.
          scale: 0.82,
        },
      };
    </script>
    <script
      defer
      type="text/javascript"
      id="MathJax-script"
      src="{{ site.third_party_libraries.mathjax.url.js }}"
      integrity="{{ site.third_party_libraries.mathjax.integrity.js }}"
      crossorigin="anonymous"
    ></script>
  {% endunless %}
{% endif %}
